# Окружение nextapp. Скопируй в nextapp/.env и заполни.

# Postgres. В проде — managed-инстанс (Neon/Supabase/облачный Postgres),
# локально — любой доступный сервер.
DATABASE_URL=postgresql://user:password@localhost:5432/cs2stats

# Публичный origin приложения: return_to для Steam OpenID и callback-URL парсера.
APP_URL=http://localhost:3000

# Ключ подписи сессионной cookie, минимум 32 символа.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ключ Steam Web API — нужен для подтягивания ника и аватара при логине.
# Получить: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# steamid64 через запятую: эти аккаунты получают права админа при входе.
# Свой id можно посмотреть на https://steamid.io
ADMIN_STEAM_IDS=

# Адрес сервиса парсинга (тот же хост, локальный интерфейс).
DEMO_SERVER_URL=http://localhost:3001

# Сколько ждать результат разбора одной демки, мс. Большие демки идут дольше
# минуты, поэтому запас большой. По умолчанию 300000 (5 минут).
PARSE_TIMEOUT_MS=300000

# Общий секрет с cs-parser: должен совпадать с INTERNAL_SERVICE_TOKEN в cs-parser/.env
INTERNAL_SERVICE_TOKEN=
