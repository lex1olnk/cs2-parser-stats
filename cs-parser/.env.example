# Окружение cs-parser. Скопируй в cs-parser/.env и заполни.
# (nextapp читает свой собственный nextapp/.env — см. nextapp/.env.example)

# Порт и интерфейс. Парсер служебный: наружу его публиковать нельзя,
# поэтому по умолчанию он слушает только localhost.
PORT=3001
BIND_HOST=127.0.0.1

# Общий секрет с nextapp: должен совпадать с INTERNAL_SERVICE_TOKEN в nextapp/.env.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_TOKEN=

# Единственный origin, куда парсеру разрешено отправлять callback с результатами.
# В проде — публичный адрес сайта, например https://example.com
CALLBACK_ORIGIN=http://localhost:3000
